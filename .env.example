# dsh-plugin-oss-backup 环境变量模板
#
# 插件只关心一件事：**这些键在你的进程环境里存不存在**。至于值怎么来的，它不关心。
# 所以下面这些都等价，用你顺手的那个就行：
#
#   · 系统环境变量（Windows `setx` / macOS·Linux `export`）
#   · 复制本文件为 `.env`，放在下面任一个位置，插件启动时会自动读：
#       <DSH home>/oss-backup/.env      （插件专属，推荐；DSH home 默认 ~/.dsh）
#       <当前工作目录>/.env              （项目里放一份，跟代码一起管）
#   · Docker：`docker run -e RUSTFS_ACCESS_KEY=...`
#   · CI：GitHub Actions Secrets / GitLab CI Variables
#   · 1Password CLI：`op run -- dsh web`（它把引用解析成环境变量再启动子进程）
#
# 优先级：**`.env` > 系统环境变量**。`.env` 是你显式写下来的那份，比机器上残留的旧
# export 更权威 —— 否则"我在 .env 里改了却毫无效果"会非常难查。被覆盖的键名会进日志
# （只有名字，没有值）。
#
# ⚠️ 插件对 `.env` **只读、永不写入**。要不要把密钥落在磁盘上，完全由你决定。
#
# ⚠️ 绝对不要把填好值的 `.env` 提交进版本库
#    （.gitignore 已挡住 .env / .env.* / *.key / *.pem）。
#    更稳的做法是用系统环境变量或密码管理器（见 README 的 setx 示例）。
#
# ⚠️ 请使用**最小权限子账号**：只给目标 Bucket 的 PutObject
#    （再给 GetObject/HeadObject 便于校验）。不要用主账号 AK/SK，
#    也不要把密钥贴进聊天、issue、截图或 CI 日志。
#
# 用法：
#   1. 选一个 provider，照抄下面那一组的变量名；
#   2. 配好之后必须**重启 dsh web** —— 宿主只在进程启动时读一次这些变量
#      （`.env` 也是在启动时读的，改了同样要重启）。

# ── provider 选择 ───────────────────────────────────────────────────────────
# rustfs（默认）| aliyun | aws
OSS_PROVIDER=

# ── rustfs / MinIO 等自建 S3 兼容端点（path-style 寻址）────────────────────
RUSTFS_ENDPOINT=            # 例：http://127.0.0.1:9000（必填）
RUSTFS_BUCKET=              # 目标存储桶（必填）
RUSTFS_REGION=              # 可选，默认 us-east-1
RUSTFS_ACCESS_KEY=          # 最小权限子账号的 AK（必填）
RUSTFS_SECRET_KEY=          # 最小权限子账号的 SK（必填）

# ── 阿里云 OSS（虚拟主机风格寻址）──────────────────────────────────────────
OSS_ENDPOINT=               # 可留空：会按 OSS_REGION 推导 https://<region>.aliyuncs.com
OSS_BUCKET=                 # 目标存储桶（必填）
OSS_REGION=                 # 例：oss-cn-hangzhou（默认同左）
OSS_ACCESS_KEY_ID=          # RAM 子账号的 AccessKey ID（必填）
OSS_ACCESS_KEY_SECRET=      # RAM 子账号的 AccessKey Secret（必填）

# ── AWS S3（标准 S3 配置）──────────────────────────────────────────────────
AWS_ENDPOINT=               # 留空即用 AWS 标准端点
AWS_BUCKET=                 # 目标存储桶（必填）
AWS_REGION=                 # 必填，例：us-east-1
AWS_ACCESS_KEY_ID=          # IAM 用户的 AccessKey ID（必填）
AWS_SECRET_ACCESS_KEY=      # IAM 用户的 Secret Access Key（必填）
